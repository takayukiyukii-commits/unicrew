{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UNICREW",
  "version": "0.3.4",
  "identifier": "jp.unilinks.unicrew",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "UNICREW",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "theme": "Light",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "updater"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "ZUBOLAND の Pure CLI Conductor 型 AI デスクトップ",
    "longDescription": "UNICREW は AIを動かすことに特化したデスクトップアプリです。Anthropic / OpenAI 公式 CLI（claude / codex / gemini / goose / opencode / codex-acp / kiro / qwen / kimi）を subprocess として束ねる Pure CLI Conductor 型ランチャーで、複数 AI を同時に並べて議論させたり、キャラクター別の役割で頼み分けたりできます。Claude Pro/Max・ChatGPT Plus/Pro のサブスクリプションでそのまま動き、追加の API 課金もありません。完全無料（Apache-2.0）で配布されており、配布元の ZUBOLAND 株式会社（uniLinks 事業群を運営）が提供するメインの AI 開発体験になります。",
    "copyright": "© 2026 ZUBOLAND株式会社 / uniLinks. All rights reserved.",
    "publisher": "ZUBOLAND株式会社",
    "homepage": "https://uni-core.jp/",
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "Japanese",
          "English"
        ]
      },
      "signCommand": {
        "cmd": "node",
        "args": [
          "../scripts/sign-windows.mjs",
          "%1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "",
      "providerShortName": "uniLinks",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/takayukiyukii-commits/unicrew/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQkQ1MDg4MjUwQkYyQ0YKUldUUDhnc2xpRkM5UFRidWhzS2lENUw2NmY3YmU4QXhxdmFCWFZiWWo2VFFFYjNqdmozbDVGM0gK",
      "dialog": false
    }
  }
}
