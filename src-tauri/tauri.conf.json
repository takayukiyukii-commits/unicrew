{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UNICREW",
  "version": "0.2.0",
  "identifier": "jp.unilinks.unicrew",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "UNICREW",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AIを動かすことに特化したマルチAIデスクトップ",
    "longDescription": "UNICREW は AIを動かすことに特化したデスクトップアプリ。Anthropic / OpenAI 公式 CLI（claude / codex）を subprocess として束ねるピュアCLIランチャーで、複数AIを同時に並べて議論させたり、キャラクター別の役割で頼み分けたりできます。サブスクリプション（Pro/Max / ChatGPT Plus）でそのまま動きます。",
    "copyright": "© 2026 ZUBOLAND / uniLinks",
    "publisher": "ZUBOLAND",
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["Japanese", "English"]
      }
    }
  }
}
